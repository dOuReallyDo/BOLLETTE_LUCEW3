{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bollette-lucew3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev disabled: it would bypass Cloudflare Access on the custom domain
  "workers_dev": false,
  "routes": [{ "pattern": "bollette.mailittlexp.org", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
